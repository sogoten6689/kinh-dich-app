{
  "name": "kinh-dich-app",
  "private": true,
  "version": "0.1.0",
  "description": "Ứng dụng Kinh Dịch — web (Vite + React) và mobile (Expo) dùng chung lõi @kinh-dich/core",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @kinh-dich/web",
    "dev:mobile": "npm run start -w @kinh-dich/mobile",
    "build": "npm run build -w @kinh-dich/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify": "npm run typecheck && npm run test"
  },
  "engines": {
    "node": ">=20"
  }
}
